    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
